<?xml version="1.0" encoding="utf-8"?>
<!--
  What the picker shows for the lyric widget on API 31+, where previewLayout is
  inflated live rather than an image being drawn.

  A copy of widget_lyric with stand-in text, and only because of the text: the
  real layout already previews itself correctly — widget_art carries no bitmap
  until a provider fills it, so the root's gradient background shows through.
  The lyric stand-in is written out rather than pointed at a string because it
  is decoration only, never shown anywhere else.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_preview_art">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/widget_band_lyric"
        android:layout_gravity="bottom"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingLeft="14dp"
        android:paddingRight="4dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingRight="8dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="@font/space_grotesk_semibold"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:text="@string/widget_preview_title"
                android:textColor="#FFFFFFFF"
                android:textSize="14sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:fontFamily="@font/inter_regular"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:text="@string/widget_preview_artist"
                android:textColor="#B3FFFFFF"
                android:textSize="12sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:ellipsize="end"
                android:fontFamily="@font/inter_regular"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:text="♪ La la la, sing along…"
                android:textColor="#E6FFFFFF"
                android:textSize="13sp" />
        </LinearLayout>

        <ImageView
            android:layout_width="@dimen/widget_button_wide"
            android:layout_height="@dimen/widget_button_wide"
            android:background="@drawable/widget_transport_button"
            android:contentDescription="@string/widget_pause"
            android:padding="10dp"
            android:src="@drawable/ic_widget_pause" />

        <ImageView
            android:layout_width="@dimen/widget_button_wide"
            android:layout_height="@dimen/widget_button_wide"
            android:background="@drawable/widget_transport_button"
            android:contentDescription="@string/widget_next"
            android:padding="10dp"
            android:src="@drawable/ic_widget_next" />
    </LinearLayout>
</FrameLayout>
