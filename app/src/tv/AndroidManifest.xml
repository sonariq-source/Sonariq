<?xml version="1.0" encoding="utf-8"?>
<!--
    Sonariq TV manifest overlay: adds the leanback launcher entry.
    The phone's MainActivity keeps its LAUNCHER filter from the main manifest;
    on Android TV only LEANBACK_LAUNCHER entries appear on the home screen,
    so the two never clash.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-feature
        android:name="android.software.leanback"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.touchscreen"
        android:required="false" />
    <!-- Karaoke scoring uses the mic when it's there, but the TV app must
         install on TVs without one (e.g. KONKA). -->
    <uses-feature
        android:name="android.hardware.microphone"
        android:required="false" />

    <application>
        <activity
            android:name="com.music.sonariq.tv.TvActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden"
            android:theme="@style/Theme.Sonariq">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
